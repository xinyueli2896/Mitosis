#!/bin/bash
# SLURM (GPU): T3 -- whole-song-gen UNCONDITIONAL generation (block (ii)
# of the E1 external comparison; EXPERIMENTS.md 2.6).
#
# Runs the released CLI (inference_whole_song.py) in its native
# unconditional mode: form is generated by the frm stage, then
# ctp -> lsh -> acc. We keep the lsh level (melody+chords) for scoring;
# acc runs anyway (their pipeline is one piece) and is ignored.
#
# Also does two one-time chores the setup job left over:
#   * flattens the doubly-nested zip payloads
#     (results_default/results_default -> results_default etc.) into the
#     layout the code hard-codes;
#   * prints the CONTAMINATION CHECK from their shipped
#     data/pop909_split/split.npz: which of our test songs 001-005 were
#     in their train vs valid split (2.6 decision (c) note).
#
# Env knobs (--export=ALL,KEY=val):
#   NSAMPLE   number of unconditional songs to generate. default 5.
#   DEMO_DIR  output dir. default temp/wholesong_uncond (under
#             midi_yinyang; their script creates a timestamped subdir
#             per run containing generation-<i>.mid + form.txt).
#
# Examples:
#   sbatch midi_yinyang/infer_wholesong_uncond.sbatch
#   sbatch --export=ALL,NSAMPLE=20 midi_yinyang/infer_wholesong_uncond.sbatch

#SBATCH --job-name=infer_wholesong_uncond
#SBATCH --output=/home/xinyue.li/logs/%x_%j.out
#SBATCH --error=/home/xinyue.li/logs/%x_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH -p cscc-gpu-p
#SBATCH -q cscc-gpu-qos
#SBATCH --time=12:00:00

set -euo pipefail
source ~/.bashrc

CONDA_ENV=mitosis
REPO_DIR=/home/xinyue.li/Mitosis
MY="$REPO_DIR/midi_yinyang"
WS="$MY/external/whole_song_gen"

conda activate "$CONDA_ENV"
mkdir -p /home/xinyue.li/logs

NSAMPLE="${NSAMPLE:-5}"
DEMO_DIR="${DEMO_DIR:-$MY/temp/wholesong_uncond}"
mkdir -p "$DEMO_DIR"

echo "================================================================"
echo "Job ${SLURM_JOB_ID:-local}  node=$(hostname)"
echo "T3: whole-song-gen unconditional   NSAMPLE=$NSAMPLE"
echo "DEMO_DIR=$DEMO_DIR"
echo "================================================================"

[[ -d "$WS/.venv" ]] || { echo "ERROR: run setup_wholesong.sbatch first"; exit 1; }
# shellcheck disable=SC1091
source "$WS/.venv/bin/activate"

# ---- flatten the doubly-nested zip payloads (idempotent) ---------------
# The zips carry their directory name inside, so extraction produced
# e.g. results_default/results_default/frm---; the code hard-codes the
# flat layout (get_model_path('results_default/frm---/v-default'),
# PROJECT/pretrained_models/*.pt, PROJECT/data/pop909_split/split.npz).
shopt -s dotglob   # the zips carry dotfiles (.DS_Store & co.); a bare *
                   # misses them and the rmdir below then fails
for d in pretrained_models results_default data; do
    if [[ -d "$WS/$d/$d" ]]; then
        echo "[layout] flattening $d/$d -> $d"
        mv "$WS/$d/$d"/* "$WS/$d/"
        rmdir "$WS/$d/$d"
    fi
done
shopt -u dotglob
echo "[layout] results_default now holds: $(ls "$WS/results_default" | tr '\n' ' ')"

# ---- contamination check against their SHIPPED split -------------------
echo "----------------------------------------------------------------"
echo "[split] our test songs in THEIR train/valid split (split.npz):"
python - <<PY
import numpy as np, os
fn = os.path.join("$WS", 'data', 'pop909_split', 'split.npz')
if not os.path.isfile(fn):
    print(f'  [warn] {fn} not found; check the data payload layout')
else:
    z = np.load(fn)
    train, valid = set(z['train_inds'].tolist()), set(z['valid_inds'].tolist())
    for i in range(5):
        where = 'TRAIN' if i in train else ('VALID' if i in valid else 'ABSENT')
        print(f'  song {i+1:03d} (index {i}): {where}')
    print(f'  (n_train={len(train)}, n_valid={len(valid)}; index i = song i+1 '
          f'by their sorted reading order)')
PY

# ---- T3: unconditional generation --------------------------------------
echo "----------------------------------------------------------------"
cd "$WS"
python inference_whole_song.py --nsample "$NSAMPLE" --demo_dir "$DEMO_DIR"

echo "================================================================"
echo "Produced:"
ls -lt "$DEMO_DIR" | head -8
find "$DEMO_DIR" -name '*.mid' | head -30
echo "----------------------------------------------------------------"
echo "Output midi track layout (from their output(), for the T4"
echo "converter): ins0=melody, ins1=reduced chords, ins2=melody (dup),"
echo "ins3=chords, ins4=accompaniment; tempo 90. We keep ins0+ins3."
echo "================================================================"
