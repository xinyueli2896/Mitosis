#!/bin/bash
# SLURM (CPU): why does a merged single-stream output carry only ONE
# program when its prompt carried two? Wraps check_program_collapse.py,
# which walks the pipeline in order -- training data, prompts, generated
# outputs -- and prints a verdict naming the stage at fault.
#
# Applies to the MERGED models (S1 / S0 / S-scratch), where the program
# IS the stream identity. The duet models (A.1/A.2/B.1) write both
# streams on program 0 by design and are distinguished by track name, so
# a single program there is expected and not a defect.
#
# Env knobs (--export=ALL,KEY=val):
#   OUT           REQUIRED. temp/<save_name> dir holding the continuations.
#   DATA          merged training .pt.
#                 default data/pop909_melchord_cp16_v2.pt
#   PROMPT_FOLDER merged, program-tagged prompts fed to inference. Every
#                 E1 run stages them at <its OUT_ROOT>/prompts/merged_tagged.
#   PROMPT_FRAMES default 96 (must match the run being diagnosed).
#   CHORD_PROGRAM default 48.
#
# Example (S-scratch generated by infer_singlestream_e1.sbatch):
#   sbatch --export=ALL,\
# OUT=temp/e1_melchord_Sscratch_p96,\
# PROMPT_FOLDER=temp/e1_melchord_165497/prompts/merged_tagged \
#       midi_yinyang/diagnose_program_collapse.sbatch

#SBATCH --job-name=diag_program_collapse
#SBATCH --output=/home/xinyue.li/logs/%x_%j.out
#SBATCH --error=/home/xinyue.li/logs/%x_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH -p cscc-cpu-p
#SBATCH -q cscc-cpu-qos
#SBATCH --time=00:30:00

set -euo pipefail
source ~/.bashrc

CONDA_ENV=mitosis
REPO_DIR=/home/xinyue.li/Mitosis

OUT="${OUT:-}"
DATA="${DATA:-data/pop909_melchord_cp16_v2.pt}"
PROMPT_FOLDER="${PROMPT_FOLDER:-}"
PROMPT_FRAMES="${PROMPT_FRAMES:-96}"
CHORD_PROGRAM="${CHORD_PROGRAM:-48}"

conda activate "$CONDA_ENV"
cd "$REPO_DIR/midi_yinyang"
mkdir -p /home/xinyue.li/logs

if [[ -z "$OUT" ]]; then
    echo "ERROR: OUT is required (the temp/<save_name> dir to diagnose)."
    echo "  sbatch --export=ALL,OUT=temp/e1_melchord_Sscratch_p96,\\"
    echo "PROMPT_FOLDER=temp/e1_melchord_<jobid>/prompts/merged_tagged \\"
    echo "      midi_yinyang/diagnose_program_collapse.sbatch"
    exit 1
fi

echo "================================================================"
echo "Job ${SLURM_JOB_ID:-local}  node=$(hostname)"
echo "OUT=$OUT"
echo "DATA=$DATA"
echo "PROMPT_FOLDER=${PROMPT_FOLDER:-<skipped>}"
echo "PROMPT_FRAMES=$PROMPT_FRAMES  CHORD_PROGRAM=$CHORD_PROGRAM"
echo "================================================================"

ARGS=(--out "$OUT" --prompt-frames "$PROMPT_FRAMES"
      --chord-program "$CHORD_PROGRAM")
[[ -n "$DATA" ]] && ARGS+=(--data "$DATA")
[[ -n "$PROMPT_FOLDER" ]] && ARGS+=(--prompt-folder "$PROMPT_FOLDER")

python check_program_collapse.py "${ARGS[@]}"
